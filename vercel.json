{
  "version": 2,
  "installCommand": "cd frontend/pj && npm install --no-optional",
  "builds": [
    {
      "src": "frontend/pj/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)",
      "dest": "/index.html"
    }
  ]
}

